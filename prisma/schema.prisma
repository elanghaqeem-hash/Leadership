generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  STANDARD
}

enum MagicLinkPurpose {
  MANAGER_LOGIN
  ACCOUNT_ACTIVATION
}

enum MfaChallengePurpose {
  LOGIN
  ENROLLMENT
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum TenantRole {
  PROGRAM_ADMIN
  SPONSOR_VIEWER
  MEMBER
}

enum BatchRole {
  PROGRAM_ADMIN
  LEAD_TRAINER
  CO_FACILITATOR
  PARTICIPANT
  LINE_MANAGER
  SPONSOR_VIEWER
}

enum BatchStatus {
  DRAFT
  PRE_TRAINING
  ACTIVE
  FOLLOW_UP
  CLOSED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum ActivityStatus {
  DRAFT
  OPEN
  LOCKED
  REVEALED
  CLOSED
}

enum ActivityType {
  SELF_DIAGNOSTIC
  MINUTE_AUDIT
  PRE_TEST
  POST_TEST
  PRIORITY_SCORECARD
  WEEKLY_PLANNER
  DAILY_BIG_3
  MEETING_CHECKLIST
  DELEGATION_CONTRACT
  RACI_BUILDER
  GROW_COACHING
  SBI_FEEDBACK
  FACT_ASSUMPTION_OPINION_UNKNOWN
  FIVE_WHYS
  FISHBONE
  ISSUE_TREE
  BIAS_CHECKLIST
  DECISION_MATRIX
  PRE_MORTEM
  DECISION_LOG
  ACTION_TRACKER
  LEADERSHIP_MIRROR
  PRIORITY_POKER
  CALENDAR_TETRIS
  DELEGATION_RELAY
  FACT_OR_FICTION
  DETECTIVE_ROOM
  ROOT_CAUSE_RACE
  BIAS_TRAP
  DECISION_AUCTION
  BOARDROOM
  ARENA
  WAR_ROOM
  REFLECTION
  AAR_STOP_START_CONTINUE
  EVALUATION_L1
  THIRTY_DAY_PLAN
}

enum SubmissionOwnerType {
  USER
  TEAM
}

enum AttemptKind {
  PRE
  POST
}

enum FollowUpKind {
  D7
  D14
  D30
}

enum MetricDirection {
  UP_IS_BETTER
  DOWN_IS_BETTER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  OPEN_ACTIVITY
  LOCK_ACTIVITY
  REVEAL_KEY
  SEND_EVENT
  CHANGE_SCORE
  EXPORT_DATA
  DELETE_DATA_REQUEST
  CONSENT_ACCEPTED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  name            String
  platformRole    PlatformRole  @default(STANDARD)
  passwordHash    String?
  mfaEnabled      Boolean       @default(false)
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenantMemberships TenantMembership[]
  batchMemberships  BatchMembership[]
  participantManagerLinks ParticipantManagerLink[] @relation("ParticipantLinks")
  managerParticipantLinks ParticipantManagerLink[] @relation("ManagerLinks")
  observerAssignments ObserverTeamAssignment[]
  submissions     Submission[]
  rubricScores    RubricScore[] @relation("ObserverScores")
  testAttempts    TestAttempt[]
  plans           ThirtyDayPlan[] @relation("ParticipantPlans")
  managedPlans    ThirtyDayPlan[] @relation("ManagerPlans")
  followUpsAuthored FollowUp[] @relation("FollowUpAuthor")
  evaluationsL1   EvaluationL1[]
  auditLogs       AuditLog[]
  authSessions    AuthSession[]
  magicLinkTokens MagicLinkToken[]
  mfaCredential   MfaCredential?
  mfaChallenges   MfaChallenge[]
  consents        ConsentRecord[]
  attendanceRecords AttendanceRecord[] @relation("AttendanceParticipant")
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  importJobs      ParticipantImportJob[] @relation("ImportCreatedBy")
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  retentionDays   Int?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     TenantMembership[]
  programs        Program[]
  batches         Batch[]
  teams           Team[]
  sessions        Session[]
  activities      Activity[]
  submissions     Submission[]
  contentItems    ContentItem[]
  rubrics         Rubric[]
  tests           Test[]
  plans           ThirtyDayPlan[]
  impactMetrics   ImpactMetric[]
  evaluationsL1   EvaluationL1[]
  auditLogs       AuditLog[]
  participantImportJobs ParticipantImportJob[]
  consents        ConsentRecord[]
  attendanceRecords AttendanceRecord[]
}

model TenantMembership {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole @default(MEMBER)
  displayName String?
  employeeNo String?
  unit       String?
  title      String?
  invitedAt  DateTime?
  activatedAt DateTime?
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId, role])
}

model AttendanceRecord {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  batchId     String           @db.Uuid
  userId      String           @db.Uuid
  day         Int
  status      AttendanceStatus @default(PRESENT)
  checkedInAt DateTime?
  note        String?
  markedById  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  batch       Batch            @relation(fields:[batchId],references:[id],onDelete:Cascade)
  user        User             @relation("AttendanceParticipant",fields:[userId],references:[id],onDelete:Cascade)
  markedBy    User?            @relation("AttendanceMarker",fields:[markedById],references:[id],onDelete:SetNull)
  @@unique([batchId,userId,day])
  @@index([tenantId,batchId,day,status])
  @@index([userId,batchId])
}

model Program {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  name        String
  code        String
  isTemplate  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    ProgramVersion[]
  @@unique([tenantId, code])
}

model ProgramVersion {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String    @db.Uuid
  version     Int
  status      String    @default("DRAFT")
  contentHash String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  scoringConfig ProgramScoringConfig?
  batches     Batch[]
  contentLinks ProgramContentLink[]
  @@unique([programId, version])
}

model ProgramScoringConfig {
  id               String   @id @default(uuid()) @db.Uuid
  programVersionId String   @unique @db.Uuid
  schemaVersion    Int      @default(1)
  config           Json     @db.JsonB
  configHash       String
  createdAt        DateTime @default(now())
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
}

model Batch {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  programVersionId String      @db.Uuid
  code             String
  name             String
  joinCode         String      @unique
  startDate        DateTime
  endDate          DateTime
  location         String?
  status           BatchStatus @default(DRAFT)
  teamCount        Int         @default(4)
  participantTarget Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  memberships      BatchMembership[]
  managerLinks     ParticipantManagerLink[]
  observerAssignments ObserverTeamAssignment[]
  attendanceRecords AttendanceRecord[]
  teams            Team[]
  sessions         Session[]
  activities       Activity[]
  submissions      Submission[]
  gameRounds       GameRound[]
  batchScoringConfig BatchScoringConfig?
  plans            ThirtyDayPlan[]
  impactMetrics    ImpactMetric[]
  evaluationsL1    EvaluationL1[]
  auditLogs        AuditLog[]
  importJobs       ParticipantImportJob[]
  @@unique([tenantId, code])
  @@index([tenantId, status, startDate])
}

model BatchScoringConfig {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @unique @db.Uuid
  schemaVersion Int      @default(1)
  config        Json     @db.JsonB
  sourceHash    String
  frozenAt      DateTime?
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model BatchMembership {
  id        String    @id @default(uuid()) @db.Uuid
  batchId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BatchRole
  teamId    String?   @db.Uuid
  isActive  Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  @@unique([batchId, userId])
  @@index([batchId, role])
  @@index([teamId])
}

model ParticipantManagerLink {
  id                String   @id @default(uuid()) @db.Uuid
  batchId           String   @db.Uuid
  participantUserId String   @db.Uuid
  managerUserId     String   @db.Uuid
  createdAt         DateTime @default(now())
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participant       User     @relation("ParticipantLinks", fields: [participantUserId], references: [id], onDelete: Cascade)
  manager           User     @relation("ManagerLinks", fields: [managerUserId], references: [id], onDelete: Cascade)
  @@unique([batchId, participantUserId])
  @@index([batchId, managerUserId])
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  batchId   String   @db.Uuid
  name      String
  number    Int
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  members   BatchMembership[]
  observerAssignments ObserverTeamAssignment[]
  submissions Submission[]
  rubricScores RubricScore[]
  gameRounds GameRound[]
  @@unique([batchId, number])
  @@index([tenantId, batchId])
}

model ObserverTeamAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  batchId        String   @db.Uuid
  observerUserId String   @db.Uuid
  teamId         String   @db.Uuid
  createdAt      DateTime @default(now())
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  observer       User     @relation(fields: [observerUserId], references: [id], onDelete: Cascade)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([batchId, observerUserId, teamId])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  batchId     String   @db.Uuid
  sequence    Int
  code        String
  title       String
  startsAt    DateTime?
  endsAt      DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activities  Activity[]
  @@unique([batchId, sequence])
  @@unique([batchId, code])
}

model Activity {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  batchId       String         @db.Uuid
  sessionId     String?        @db.Uuid
  type          ActivityType
  title         String
  sequence      Int
  status        ActivityStatus @default(DRAFT)
  config        Json           @db.JsonB
  contentVersion String?
  openedAt      DateTime?
  lockedAt      DateTime?
  revealedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch         Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  session       Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  submissions   Submission[]
  gameRounds    GameRound[]
  rubricScores  RubricScore[]
  @@index([tenantId, batchId, status])
  @@index([batchId, sequence])
}

model Submission {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  batchId        String              @db.Uuid
  activityId     String              @db.Uuid
  ownerType      SubmissionOwnerType
  userId         String?             @db.Uuid
  teamId         String?             @db.Uuid
  submissionKey  String              @unique
  payload        Json                @db.JsonB
  score          Decimal?            @db.Decimal(10, 4)
  scoreDetail    Json?               @db.JsonB
  isPrivateReflection Boolean        @default(false)
  version        Int                 @default(1)
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch          Batch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activity       Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([tenantId, batchId, activityId])
  @@index([userId, activityId])
  @@index([teamId, activityId])
}

model GameRound {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String   @db.Uuid
  activityId  String   @db.Uuid
  teamId      String?  @db.Uuid
  roundNo     Int
  state       Json     @db.JsonB
  openedAt    DateTime?
  closedAt    DateTime?
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([activityId, teamId, roundNo])
}

model ContentItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  type        String
  code        String
  version     Int
  title       String
  payload     Json     @db.JsonB
  answerKey   Json?    @db.JsonB
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programLinks ProgramContentLink[]
  @@unique([tenantId, code, version])
  @@index([type, isPublished])
}

model ProgramContentLink {
  id               String   @id @default(uuid()) @db.Uuid
  programVersionId String   @db.Uuid
  contentItemId    String   @db.Uuid
  sequence         Int?
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  contentItem      ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  @@unique([programVersionId, contentItemId])
}

model Rubric {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  code        String
  name        String
  version     Int
  dimensions  Json     @db.JsonB
  isPublished Boolean  @default(false)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scores      RubricScore[]
  @@unique([tenantId, code, version])
}

model RubricScore {
  id             String   @id @default(uuid()) @db.Uuid
  activityId     String   @db.Uuid
  rubricId       String   @db.Uuid
  observerUserId String   @db.Uuid
  teamId         String   @db.Uuid
  dimensionCode  String
  rawValue       Decimal  @db.Decimal(10, 4)
  weightedValue  Decimal? @db.Decimal(10, 4)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  rubric         Rubric   @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  observer       User     @relation("ObserverScores", fields: [observerUserId], references: [id], onDelete: Restrict)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([activityId, observerUserId, teamId, dimensionCode])
}

model Test {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  code        String
  name        String
  version     Int
  durationSec Int?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    TestAttempt[]
  @@unique([tenantId, code, version])
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  testId      String   @db.Uuid
  code        String
  prompt      String
  options     Json     @db.JsonB
  answerKey   String
  explanation String?
  points      Int      @default(5)
  sequence    Int
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([testId, code])
}

model TestAttempt {
  id          String      @id @default(uuid()) @db.Uuid
  testId      String      @db.Uuid
  userId      String      @db.Uuid
  batchId     String      @db.Uuid
  kind        AttemptKind
  answers     Json        @db.JsonB
  score       Int
  startedAt   DateTime
  submittedAt DateTime?
  test        Test        @relation(fields: [testId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([testId, userId, batchId, kind])
  @@index([batchId, kind])
}

model ThirtyDayPlan {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  batchId           String   @db.Uuid
  participantUserId String   @db.Uuid
  managerUserId     String?  @db.Uuid
  startDate         DateTime
  reviewD7          DateTime
  reviewD14         DateTime
  reviewD30         DateTime
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participant       User     @relation("ParticipantPlans", fields: [participantUserId], references: [id], onDelete: Cascade)
  manager           User?    @relation("ManagerPlans", fields: [managerUserId], references: [id], onDelete: SetNull)
  targets           PlanTarget[]
  followUps         FollowUp[]
  @@unique([batchId, participantUserId])
}

model PlanTarget {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @db.Uuid
  sequence    Int
  behavior    String
  elements    Json     @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        ThirtyDayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, sequence])
}

model FollowUp {
  id           String       @id @default(uuid()) @db.Uuid
  planId       String       @db.Uuid
  kind         FollowUpKind
  authorUserId String       @db.Uuid
  answers      Json         @db.JsonB
  progressPct  Decimal      @db.Decimal(5, 2)
  statusLabel  String
  submittedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  plan         ThirtyDayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  author       User         @relation("FollowUpAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  @@unique([planId, kind])
}

model ImpactMetric {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  batchId           String          @db.Uuid
  participantUserId String          @db.Uuid
  code              String
  name              String
  direction         MetricDirection
  baseline          Decimal?        @db.Decimal(18, 4)
  day30             Decimal?        @db.Decimal(18, 4)
  percentChange     Decimal?        @db.Decimal(12, 6)
  improved          Boolean?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch             Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@unique([batchId, participantUserId, code])
}

model EvaluationL1 {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  batchId           String   @db.Uuid
  participantUserId String   @db.Uuid
  answers           Json     @db.JsonB
  averageScore      Decimal? @db.Decimal(10, 4)
  submittedAt       DateTime?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participant       User     @relation(fields: [participantUserId], references: [id], onDelete: Cascade)
  @@unique([batchId, participantUserId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String?     @db.Uuid
  batchId     String?     @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  resourceType String
  resourceId  String?
  beforeHash  String?
  afterHash   String?
  metadata    Json?       @db.JsonB
  ipHash      String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  batch       Batch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([batchId, createdAt])
  @@index([actorUserId, createdAt])
}


model AuthSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime @default(now())
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model MagicLinkToken {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  purpose     MagicLinkPurpose
  tokenHash   String           @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}

model MfaCredential {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  encryptedSecret String
  iv              String
  authTag         String
  enabledAt       DateTime?
  lastUsedCounter BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaChallenge {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  purpose    MfaChallengePurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}

model ConsentRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tenantId    String?  @db.Uuid
  version     String
  acceptedAt  DateTime @default(now())
  ipHash      String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([userId, acceptedAt])
  @@index([tenantId, acceptedAt])
}

model ParticipantImportJob {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  batchId       String          @db.Uuid
  createdById   String          @db.Uuid
  fileName      String
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0)
  successRows   Int             @default(0)
  failedRows    Int             @default(0)
  warnings      Json?           @db.JsonB
  errors        Json?           @db.JsonB
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch         Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([tenantId, batchId, createdAt])
}


model RateLimitBucket {
  key         String   @id
  scope       String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt
  @@index([expiresAt])
  @@index([scope, windowStart])
}
