DATABASE_URL=postgresql://app_user:change-me@localhost:5432/leadership?schema=public
APP_URL=http://localhost:3000
APP_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-separate-at-least-32-random-characters
SESSION_COOKIE_NAME=ltw_session
SESSION_TTL_HOURS=12
MAGIC_LINK_TTL_MINUTES=20
MFA_CHALLENGE_TTL_SECONDS=300

# Optional initial platform bootstrap. Use secrets management; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Follow-up reminders (D+7/D+14/D+30)
CRON_SECRET=replace-with-random-cron-secret
NOTIFICATION_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Realtime transport
# Set to 1 only when the app is started with: npm --workspace @ltw/web run start:ws
NEXT_PUBLIC_REALTIME_WS_ENABLED=0
# Optional absolute base URL, e.g. wss://leadership.example.com. Leave blank for same-origin.
NEXT_PUBLIC_REALTIME_WS_URL=
